# ARTEX native runtime environment variables (optional — can also be configured via config.json and the UI)

# PostgreSQL connection URI (overrides database.* in config.json)
# ARTEX_PG_DSN=postgres://artex:password@127.0.0.1:5432/artex?sslmode=disable

# Reverse proxies (comma-separated CIDRs) whose X-Forwarded-For the login rate
# limit trusts. Empty: the header is ignored.
ARTEX_TRUSTED_PROXIES=

# Optional key for the secrets encrypted in the database (32 bytes, base64 or hex,
# e.g. `openssl rand -base64 32`). Empty: keys/secret.key, generated at first start.
# ARTEX_SECRET_KEY=

# LLM (fill one or both; you can also leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
# Allow the UI model list to reach a local LLM endpoint, e.g. 127.0.0.1:11434
ARTEX_LLM_PRIVATE_ENDPOINTS=

# Untrusted-output boundary. Frames every tool output between nonce-tagged markers so
# the model treats it as data, not instructions. On by default (unset or empty = on);
# set ARTEX_UNTRUSTED_BOUNDARY=0 (or false/off/no) to disable it.
# ARTEX_UNTRUSTED_BOUNDARY=0

# Noise profile of the requests ARTEX sends to targets (off | quiet | balanced | aggressive).
# ARTEX_NOISE_PROFILE=balanced
# User-Agent set on target requests that have none, only under a profile.
# ARTEX_TARGET_USER_AGENT=

# Run budgets (optional). Unset or 0 = unlimited.
# ARTEX_TASK_BUDGET_TOKENS=
# ARTEX_TASK_BUDGET_TURNS=
# ARTEX_INTENT_BUDGET_TOKENS=
# ARTEX_INTENT_BUDGET_TURNS=

# Update banner (optional). ARTEX_UPDATE_CHECK=1 checks GitHub releases at most once per 24h.
# ARTEX_UPDATE_CHECK=1
