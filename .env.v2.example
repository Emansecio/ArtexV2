# ArtexV2 isolated deployment configuration (copy to .env.v2)
# Runs on dedicated ports 18787 (Web UI) and 18788 (MITM proxy) with its own
# Postgres volume (pgdata_v2) so it never collides with an existing ARTEX instance.
#
# Start with:
#   docker compose -f docker-compose.v2.yml -p artex-v2 --env-file .env.v2 up -d

ARTEX_BIND_ADDR=127.0.0.1
POSTGRES_USER=artex_v2
POSTGRES_PASSWORD=change-me-v2
POSTGRES_DB=artex_v2

# Primary LLM (or leave empty and configure in the Web UI at http://127.0.0.1:18787)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
ARTEX_LLM_PRIVATE_ENDPOINTS=

# --- Token, cache, spill & compaction optimizations ---
# Context telemetry: logs byte-size composition & cache_read_ratio (no prompt bodies)
# Query via GET http://127.0.0.1:18787/api/llm/context/summary?days=7
ARTEX_CONTEXT_TELEMETRY=1

# Worker system-prompt static/dynamic cache split (1 = on by default in V2)
ARTEX_CACHE_PREFIX=1

# Prompt caching in Norma (Anthropic 3-breakpoint caching + OpenAI prompt_cache_key)
ARTEX_PROMPT_CACHE=1
# Optional Anthropic cache TTL: "" (5m default) or "1h" (useful when scans/approvals >5m)
ARTEX_PROMPT_CACHE_TTL=
# Optional OpenAI prompt_cache_retention: "" or "24h"
ARTEX_OPENAI_CACHE_RETENTION=
# Set to 1 if routing Claude through an OpenAI-compatible gateway like OpenRouter
ARTEX_OPENAI_CACHE_CONTROL=0
# Set to 1 to omit old reasoning_content from prior user turns on OpenAI-compatible endpoints
ARTEX_STRIP_OLD_REASONING=0

# Spill oversized tool outputs to disk earlier with head+tail preview (0 = legacy 30000)
ARTEX_MAX_TOOL_OUTPUT_CHARS=8000

# Optional compaction window cap in K tokens (e.g., 80 or 100) without shrinking physical routing window
# ARTEX_COMPACT_WINDOW_CAP_K=100

# MicroCompact tuning: trigger ratio (0.35 = 35% effective window) & batch interval (4 = preserve cache between batches)
ARTEX_MICRO_COMPACT_RATIO=0.35
ARTEX_MICRO_COMPACT_BATCH=4

# Trim worker turn-1 graph_overview payload (1 = on by default in V2)
ARTEX_WORKER_COMPACT_OVERVIEW=1

# Cold-digest graph compaction thresholds (faster folding than legacy 20/8)
ARTEX_COLD_DIGEST_MIN_NODES=12
ARTEX_COLD_DIGEST_MAJOR_DIGESTS=6

# Planner event debounce window in ms (2000ms coalesces finishing worker bursts)
ARTEX_PLANNER_DEBOUNCE_MS=2000

# Optional cheaper/faster LLM dedicated to AutoCompact & cold-digest summarization
# Example: claude-3-5-haiku-latest / gpt-4o-mini / gemini-2.5-flash
# ARTEX_SUMMARY_LLM_PROVIDER=
# ARTEX_SUMMARY_LLM_MODEL=
# ARTEX_SUMMARY_LLM_BASE_URL=
# ARTEX_SUMMARY_LLM_API_KEY=
# ARTEX_SUMMARY_LLM_PROXY=

# Optional hierarchical run budgets
# ARTEX_TASK_BUDGET_TOKENS=
# ARTEX_TASK_BUDGET_TURNS=
# ARTEX_INTENT_BUDGET_TOKENS=
# ARTEX_INTENT_BUDGET_TURNS=

# --- Latency, streaming, failover & concurrency optimizations ---
# Speculative background AutoCompact at 80% threshold (1 = on by default, 0 = off)
ARTEX_SPECULATIVE_COMPACT=1

# Optional speculative hedging delay in ms across 2 pool members (e.g. 1500; empty = off)
# ARTEX_LLM_HEDGE_MS=

# Force parallel execution for all MCP tools even without ReadOnlyHint (1 = force parallel)
# ARTEX_MCP_CONCURRENT=

# SSE idle watchdog timeout & HTTP response header timeout in seconds (defaults: 45s / 60s)
# NORMA_STREAM_IDLE_TIMEOUT_SEC=45
# NORMA_RESPONSE_HEADER_TIMEOUT_SEC=60
